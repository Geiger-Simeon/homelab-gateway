# copy to .env (git-ignored) and fill in; no secrets in here,
# the scripts ask for passwords, client secrets and the desec token on the terminal
# values in double quotes, the file is read by bash

# both hosts
NC_DOMAIN="cloud.homelab.test"
ADMIN_USER="admin"
# portal start page behind oauth2-proxy, own entra app registration "portal"
PORTAL_DOMAIN="portal.homelab.test"

# pi
LAN_CIDR="192.168.178.0/24"
DATA_DIR="/mnt/data"
# empty: setup-pi.sh takes the only empty disk besides the system disk (asks before formatting)
DATA_DISK=""
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
PORTAL_CLIENT_ID=""
NC_ADMIN_USER="ncadmin"
NC_SHARE_EXPIRE_DAYS="7"
NC_PHONE_REGION="DE"
# real certificate: wildcard *.ACME_DOMAIN from let's encrypt, dns-01 through desec (ADR 0020)
# empty: self-signed test certificates (vm tests with .test names)
# NC_DOMAIN and PORTAL_DOMAIN have to be exactly one label below it
# the bare domain itself gets forwarded too and redirects to the portal (ADR 0021)
ACME_DOMAIN=""
# contact for the let's encrypt account
ACME_EMAIL=""

# set by deploy.ps1, only needed when running the scripts by hand
VPS_ENDPOINT=""
VPS_WG_PUBLIC_KEY=""
PI_WG_PUBLIC_KEY=""
# public key of the PC, deploy.ps1 installs it on its own
ADMIN_SSH_PUBKEY=""
